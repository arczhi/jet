# jet configuration. Copy to .env and fill in. Never commit real keys.

# ---- Judgment model (fast System One decisions: TypeSafe / laya-mlx) ----
# provider: typesafe | openai_compat | mock
JET_JUDGE_PROVIDER=typesafe

# TypeSafe hosted API (Jev) or any compatible /v1/systemone endpoint
JET_TYPESAFE_BASE_URL=https://api.typesafe.ai
JET_TYPESAFE_API_KEY=
JET_TYPESAFE_MODEL=jev-latest

# laya-mlx or any OpenAI-compatible judgment endpoint
JET_JUDGE_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
JET_JUDGE_OPENAI_API_KEY=not-needed
JET_JUDGE_OPENAI_MODEL=laya

# ---- LLM (generation + verification) ----
# Named profiles. Select the generator with JET_LLM_PROFILE; optionally verify
# with a different model via JET_VERIFIER_LLM_PROFILE (cross-model review).
# {session_id} expands to the stable session id (required by some gateways).
JET_LLM_PROFILE=default
JET_VERIFIER_LLM_PROFILE=
JET_LLM_PROFILES={"default":{"base_url":"https://api.deepseek.com","api_key":"","model":"deepseek-flash"}}
# Example with two endpoints:
# JET_LLM_PROFILES={"zen":{"base_url":"https://opencode.ai/zen/go/v1","api_key":"","model":"deepseek-v4.1-flash","extra_headers":{"x-opencode-session":"{session_id}"}},"official":{"base_url":"https://api.deepseek.com","api_key":"","model":"deepseek-flash"}}

# ---- Session / storage ----
JET_HOME=~/.jet
# Per-turn guardrails:
#   JET_MAX_STEPS                  hard step cap (default 24)
#   JET_MAX_VERIFICATION_FAILURES  stop retrying after N unverified answers (default 3)
# There is no token cap: if a task seems stuck, stop it with ⌘. or the Stop button.
